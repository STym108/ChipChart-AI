# API Keys for ChipChart AI

# Google Gemini API Key (Required for primary AI recommendations)
# Get one from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Groq API Key (Optional - Used as a backup fallback if Gemini rate limits)
# Get one from: https://console.groq.com/
VITE_GROQ_API_KEY=

# ScraperAPI Key (Optional - Used to scrape live Amazon India prices)
# Get one from: https://www.scraperapi.com/
VITE_SCRAPERAPI_KEY=
